{
  "manifest_version": 3,
  "name": "Wise 页面监控",
  "version": "0.7.0",
  "description": "将页面异常转发到 Wise 页面监控；也可把选中图文作为需求发送给 Wise 处理。",
  "permissions": ["debugger", "tabs", "storage", "alarms", "contextMenus", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Wise 页面监控",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "wise-send-selection": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "将选中图文发送到 Wise 作为需求"
    }
  }
}

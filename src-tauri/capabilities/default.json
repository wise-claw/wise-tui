{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "mascot", "hud", "main-dock-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-set-title",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.wise" },
        { "path": "$HOME/.wise/**" },
        { "path": "$HOME/.wise/prd-runs/**" },
        { "path": "$HOME/.wise/code-reviews" },
        { "path": "$HOME/.wise/code-reviews/**" },
        { "path": "$HOME/.wise/composer-images/**" },
        { "path": "$HOME/.wise/composer-images" },
        { "path": "$HOME/.wise/prd-images/**" },
        { "path": "$HOME/.wise/prd-images" },
        { "path": "$HOME/.wise/extensions/**" },
        { "path": "$HOME/.wise/extensions" },
        { "path": "$HOME/.wise/my-extensions/**" },
        { "path": "$HOME/.wise/my-extensions" },
        { "path": "$HOME/.wise/extension-library/**" },
        { "path": "$HOME/.wise/extension-library" },
        { "path": "$HOME/.trellis/**" }
      ]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-ignore-cursor-events",
    "dialog:default",
    "fs:read-dirs",
    "fs:read-files",
    "global-shortcut:default"
  ]
}

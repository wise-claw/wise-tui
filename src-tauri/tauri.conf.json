{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wise",
  "version": "1.4.0",
  "identifier": "com.wise.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:16088",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Wise",
        "width": 1200,
        "height": 800,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      },
      {
        "label": "mascot",
        "title": "Wise Pet",
        "url": "mascot.html",
        "width": 110,
        "height": 130,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "hud",
        "title": "Wise HUD",
        "url": "hud.html",
        "width": 720,
        "height": 64,
        "minWidth": 560,
        "minHeight": 56,
        "maxWidth": 1200,
        "maxHeight": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.wise/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/skills/officecli-docx/SKILL.md",
      "resources/skills/officecli-pptx/SKILL.md",
      "resources/skills/wise-browse/SKILL.md",
      "../stagehand-cli/argv.mjs",
      "../stagehand-cli/assert.mjs",
      "../stagehand-cli/auth.mjs",
      "../examples/wise-extensions/hello-world",
      "../browser-extensions/wise-page-monitor",
      "../stagehand-cli/cli.mjs",
      "../stagehand-cli/package.json"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 150,
          "y": 168
        },
        "applicationFolderPosition": {
          "x": 468,
          "y": 168
        }
      }
    }
  }
}
